# Копия для локального запуска: cp .env.example .env
# Пустые значения — приложение стартует и без них (см. docs/ARCHITECTURE.md,
# раздел «Конфигурация»). Реальные секреты сюда и в git не помещать.

# Источник вакансий: "superjob" (по умолчанию, см. docs/DECISIONS.md,
# ADR-013/ADR-014 — HH закрыл анонимный доступ к поиску), "hh" (оставлен
# переключаемым, не удалён), "habr" (TASK-013/ADR-056 — публичный
# HTML-каталог career.habr.com, не официальный API) или "superjob_habr"
# (TASK-015 — последовательный combined-прогон: сначала SuperJob, затем
# Habr, через общие hard filters/Qwen/SQLite/Telegram; HH в combined-режим
# не входит). При "superjob_habr" оба SUPERJOB_API_KEY и непустой
# HABR_SEARCH_QUERY обязательны.
VACANCY_SOURCE=superjob

# SuperJob API (dev.superjob.ru) — авторизация заголовком X-Api-App-Id.
# SUPERJOB_KEYWORDS — несколько направлений поиска, сводятся в один запрос
# через запятую (build_superjob_search_params, ADR-014); конкретная
# релевантность — за domain/filters.py, не за этим запросом.
SUPERJOB_API_KEY=
SUPERJOB_BASE_URL=https://api.superjob.ru/2.0
SUPERJOB_REQUEST_TIMEOUT_SECONDS=10
SUPERJOB_COUNT=50
SUPERJOB_MAX_RETRIES=2
SUPERJOB_RETRY_BACKOFF_SECONDS=0.5
SUPERJOB_KEYWORDS=["AI интегратор","AI automation","AI agent","LLM интеграция","n8n","чат-бот API","автоматизация бизнес-процессов AI"]
SUPERJOB_TOWN=

# HH API (переключаемый источник, см. VACANCY_SOURCE выше)
# HH_USER_AGENT: HH API отклоняет неопознанные/шаблонные User-Agent
# (ответ "Bad User-Agent header" / "blacklisted") — перед боевым запуском
# укажите реальные название приложения и контакт. Анонимный поиск (GET
# /vacancies) закрыт HH с апреля 2026 — см. ADR-013 — этот блок сохранён
# на случай, если анонимный доступ снова откроется.
# HH_SEARCH_TEXT/HH_AREA/HH_PERIOD_DAYS сужают запрос к HH перед жёсткими
# фильтрами; конкретная релевантность — за domain/filters.py, не за этим
# запросом (см. docs/DECISIONS.md, ADR-012).
HH_BASE_URL=https://api.hh.ru
HH_USER_AGENT=vacancy-agent/0.1 (contact: not-set)
HH_REQUEST_TIMEOUT_SECONDS=10
HH_PER_PAGE=50
HH_MAX_RETRIES=2
HH_RETRY_BACKOFF_SECONDS=0.5
HH_SEARCH_TEXT='"AI-интегратор" OR "AI Integration Engineer" OR "AI Automation Engineer" OR "AI Solutions Engineer" OR "LLM Engineer" OR "Prompt Engineer"'
HH_AREA=
HH_PERIOD_DAYS=7

# Habr Career (переключаемый источник, см. VACANCY_SOURCE выше). Публичный
# HTML-каталог, не официальный API (TASK-013, ADR-056 — Habr не
# предоставляет API публичного поиска вакансий для соискателя). Пустой
# HABR_SEARCH_QUERY при выбранном habr — понятная ошибка до сети, не
# загрузка всего каталога. HABR_MAX_PAGES/HABR_MAX_VACANCIES и
# HABR_REQUEST_DELAY_SECONDS (не меньше 1) — узкие лимиты намеренно,
# без cookies/логина/CAPTCHA-обхода и без Playwright/Selenium.
HABR_BASE_URL=https://career.habr.com
HABR_USER_AGENT=vacancy-agent/0.1 (contact: not-set)
HABR_SEARCH_QUERY=
HABR_MAX_PAGES=2
HABR_MAX_VACANCIES=40
HABR_REQUEST_TIMEOUT_SECONDS=10
HABR_REQUEST_DELAY_SECONDS=1
HABR_MAX_RETRIES=2
HABR_RETRY_BACKOFF_SECONDS=0.5

# Жёсткие фильтры (docs/FILTER_PROFILE.md, ADR-008). Пустые значения здесь
# означают «взять из утверждённого профиля» (domain/default_filter_profile.py),
# а не «пустой список» — заполняйте только то, что хотите переопределить.
FILTER_TARGET_TITLES=[]
FILTER_SECONDARY_TITLES=[]
FILTER_INCLUDE_PHRASES=[]
FILTER_EXCLUDE_TITLE_PHRASES=[]
FILTER_INTERNSHIP_PHRASES=[]
FILTER_EXCLUDE_ANYWHERE_PHRASES=[]
FILTER_SALARY_MIN=
FILTER_ALLOW_MISSING_SALARY=true
FILTER_ALLOWED_AREAS=[]
FILTER_ALLOWED_WORK_FORMATS=[]
FILTER_ALLOWED_EXPERIENCE=[]
FILTER_MAX_AGE_DAYS=

# Telegram
# TELEGRAM_ALLOWED_CHAT_IDS: свой числовой ID можно узнать у @userinfobot.
# Перед первым запуском откройте чат со своим ботом и напишите ему что угодно
# (например /start) — иначе бот не сможет написать первым: Telegram вернёт
# "Bad Request: chat not found" (проверено на живом прогоне, см.
# docs/DECISIONS.md, ADR-012, «Живая проверка»).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=[]
TELEGRAM_REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_MAX_RETRIES=2
TELEGRAM_RETRY_BACKOFF_SECONDS=0.5

# Qwen / LM Studio (MVP 2, docs/DECISIONS.md ADR-015). QWEN_API_KEY LM
# Studio не проверяет, но OpenAI-совместимый клиент требует значение —
# оставьте плейсхолдер lm-studio, это не реальный секрет.
# QWEN_MODEL — точное имя модели, загруженной в LM Studio (Developer ->
# Local Server, поле "model" в его логах/API).
QWEN_BASE_URL=http://localhost:1234/v1
QWEN_MODEL=
QWEN_API_KEY=lm-studio
QWEN_MIN_SCORE=70
# Локальная генерация ощутимо медленнее облачного API и заметно
# нестабильна по времени — живые smoke-test-прогоны (ADR-015) заняли от
# ~70с до ~172с на одном и том же железе; 180с — более безопасный
# дефолт с запасом, но на медленном железе может понадобиться больше.
QWEN_REQUEST_TIMEOUT_SECONDS=180
QWEN_MAX_RETRIES=1
QWEN_RETRY_BACKOFF_SECONDS=1.0
# Подготовка черновика отклика (TASK-011, ADR-034/ADR-035) — отдельный,
# намного более тяжёлый вызов, чем массовая оценка выше: свой timeout и
# лимит вывода, тот же base_url/model/api_key/retry-политика.
QWEN_DRAFT_REQUEST_TIMEOUT_SECONDS=300
QWEN_DRAFT_MAX_OUTPUT_TOKENS=6000

# Расписание
SCHEDULE_DAILY_RUN_HOUR=9
SCHEDULE_TIMEZONE=Europe/Moscow

# База данных
DATABASE_URL=sqlite:///./data/vacancy_agent.db

# Локальный read-only API (`vacancy-agent-api`, TASK-009, ADR-028/ADR-029).
# По умолчанию — только loopback: аутентификации пока нет, менять на
# 0.0.0.0/внешний интерфейс не рекомендуется (см. docs/TASK-009.md).
API_HOST=127.0.0.1
API_PORT=8000
